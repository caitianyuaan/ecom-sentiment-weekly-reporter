{
  "version": 2,
  "profile_name": "My E-commerce Sentiment Weekly Report",
  "setup_mode": "follow_creator_settings | build_on_creator_settings | fully_customize",
  "markets": ["US", "UK"],
  "platforms": [
    "Amazon",
    "Temu",
    "SHEIN",
    "TikTok Shop",
    "eBay",
    "Instagram / Meta",
    "Walmart",
    "Google"
  ],
  "topics": [
    "policy and compliance",
    "seller governance",
    "delivery and fulfillment",
    "returns and refunds",
    "pricing and promotions",
    "content commerce",
    "ads and recommendations",
    "payment safety",
    "product authenticity",
    "customer service"
  ],
  "observation_metrics": [
    "product and selection",
    "content and discovery",
    "promotions and pricing",
    "shopping experience",
    "delivery and fulfillment",
    "after-sales and trust",
    "business scale and growth"
  ],
  "source_profile": "default",
  "sources": {
    "include": [
      "Reuters",
      "TechCrunch",
      "Bloomberg",
      "WSJ",
      "Fortune",
      "Modern Retail",
      "RetailDive",
      "EcommerceBytes",
      "MediaPost",
      "About Amazon blog",
      "Amazon Seller Forums",
      "eBay developer blog",
      "eBay Community",
      "Value Added Resource",
      "Walmart newsroom",
      "FashionNetwork UK",
      "TheIndustry.beauty",
      "The Retail Bulletin",
      "36Kr",
      "TMTPost",
      "LatePost",
      "Huxiu",
      "Ebrun",
      "AMZ123",
      "Chuhai",
      "Paidai",
      "FastMoss",
      "TKFFF",
      "IPPR",
      "Taylor Wessing",
      "BLG",
      "TechRadar",
      "T3",
      "Vogue"
    ],
    "exclude": []
  },
  "items_per_platform": {
    "min": 3,
    "max": 5
  },
  "output": {
    "markdown": {
      "enabled": false,
      "output_dir": "outputs"
    },
    "html": {
      "enabled": true,
      "output_dir": "outputs",
      "layout": "consulting_compact",
      "combine_markets": true,
      "include_images": false
    }
  },
  "delivery": {
    "local": true,
    "feishu_group": false,
    "feishu_archive": false
  },
  "feishu_group_id": "",
  "feishu_doc_url": "",
  "sender_name": "",
  "report_language": "zh-CN"
}
